{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug receiver",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Receiver: build",
      "program": "${workspaceFolder}/windows-receiver/F1Controller/bin/Debug/net8.0/FullLock.dll",
      "args": ["--port", "5555"],
